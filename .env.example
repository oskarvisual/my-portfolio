# ==============================================================================
# DIGITALOCEAN SPACES CONFIGURATION (VIDEO ASSETS CDN)
# ==============================================================================
# Access Key & Secret generated in:
# DigitalOcean Control Panel -> API -> Spaces Access Keys -> Generate New Key
DO_SPACES_KEY=your_spaces_access_key_here
DO_SPACES_SECRET=your_spaces_secret_key_here

# The exact name of your DigitalOcean Space bucket (e.g., oscar-spaces)
DO_SPACES_BUCKET=your_spaces_bucket_name

# The datacenter region of your Space (e.g., nyc3, sfo3, ams3, sgp1, fra1)
DO_SPACES_REGION=nyc3

# The destination directory inside your Space where videos will be uploaded.
# Useful when you have multiple projects/folders in the same bucket.
# Examples: "portfolio/videos", "my-portfolio/videos", "web/videos"
# (No leading or trailing slashes)
DO_SPACES_DEST_DIR=my-portfolio/videos

# ==============================================================================
# CLIENT-SIDE VITE CDN URL (Optional - used by frontend to stream from Spaces CDN)
# ==============================================================================
# Format: https://<bucket-name>.<region>.cdn.digitaloceanspaces.com/<destination-dir>
# Example: https://oscar-spaces.nyc3.cdn.digitaloceanspaces.com/my-portfolio/videos
VITE_SPACES_CDN_BASE_URL=https://your_spaces_bucket_name.nyc3.cdn.digitaloceanspaces.com/my-portfolio/videos
